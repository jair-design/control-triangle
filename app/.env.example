# Credenciales de acceso a AWS para el módulo de Login System (Cognito).
# Copia este archivo como `.env` en la raíz de `app/` y completa los valores
# con las credenciales del usuario de IAM (ver Prerrequisitos del Módulo 03).
#
# Nota: para el ejercicio se asume un usuario con AdministratorAccess por
# practicidad; no es una buena práctica de producción.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
