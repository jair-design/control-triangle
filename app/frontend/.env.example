# Parámetros públicos del app client de Cognito (cliente público: no hay client secret).
# Copia este archivo como `.env` y completa los valores.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=

# Minutos antes del vencimiento del access token en que se renueva la sesión (por defecto 5).
VITE_TOKEN_REFRESH_MARGIN_MINUTES=5
