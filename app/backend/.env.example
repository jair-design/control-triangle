# Credenciales de MongoDB para desarrollo local (docker-compose.yml las lee de aquí).
# Copia este archivo como `.env` y elige valores propios. No subas el `.env`.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# Cadena de conexión del backend. Usa el mismo usuario y contraseña de arriba.
MONGODB_URI=mongodb://USUARIO:CONTRASENA@127.0.0.1:27017/webi-todo?authSource=admin

# User Pool y app client de Cognito: el backend los usa para verificar el access token.
# No son secretos (ver los mismos valores en el .env del frontend y en la consola de Cognito).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
